 <footer>Example.com, Example Road, Example, London, EX25 7EX</footer>

 <script>
  const action = localStorage.getItem('action');
const country = localStorage.getItem('country');
const fullName = localStorage.getItem('full-name');
const orderNumber = localStorage.getItem('order-number');
const waybillNumber = localStorage.getItem('waybill-number');
const items = localStorage.getItem('items');
const currency = localStorage.getItem('currency');
const amount = localStorage.getItem('amount');
const date = localStorage.getItem('date');
const customer = localStorage.getItem('customer');
const address = localStorage.getItem('address');

document.getElementById('full-name').textContent = fullName;
document.getElementById('waybill-number').textContent = waybillNumber;
document.getElementById('date').textContent = date.split('-').reverse().join('-');
document.getElementById('customer').textContent = customer;
document.getElementById('address').textContent = address;

document.title = 'LOA to ' + action + ' - ' + orderNumber;
 </script>
