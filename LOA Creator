  const form = document.getElementById('form');
const action = document.getElementById('action');
const country = document.getElementById('country');
const fullName = document.getElementById('fullName');
const orderNumber = document.getElementById('orderNumber');
const waybillNumber = document.getElementById('waybillNumber');
const items = document.getElementById('items');
const currency = document.getElementById('currency');
const amount = document.getElementById('amount');
const date = document.getElementById('date')
const customer = document.getElementById('customer')
const address = document.getElementById('address')
const showMe = document.getElementById('showMe')

var azHide = document.getElementsByClassName('azHide')
var moHide = document.getElementsByClassName('moHide')
var viHide = document.getElementsByClassName('viHide')
var eeHide = document.getElementsByClassName('eeHide')
var menu = document.getElementsByClassName('menu');

for (var i = 0; i < menu.length; i++) {
     menu[i].addEventListener('change', function(){
          for (var j = 0; j < azHide.length; j++){
          for (var k = 0; k < moHide.length; k++){
          for (var l = 0; l < viHide.length; l++){
          for (var m = 0; m < eeHide.length; m++){
               if (action.value === 'return' && country.value === 'Azerbaijan' || action.value === 'return' && country.value === 'Indian' || action.value === 'return' && country.value === 'Turkish') {
               azHide[j].style.display = 'none', showMe.style.display = 'block';
               } else {
               azHide[j].style.display = 'block'; 
               }
               if (action.value === 'return' && country.value === 'Moroccan') {
               moHide[k].style.display = 'none', showMe.style.display = 'block'; 
               }          
               if (action.value === 'return' && country.value === 'Vietnamese') {
               viHide[l].style.display = 'none', showMe.style.display = 'block'; 
               } else {
               eeHide[m].style.display = 'none';
               }         
    }}}}});
};

for (var n = 0; n < menu.length; n++) {
     form.addEventListener('submit', function(e){
     e.preventDefault();
          if (action.value === 'return' && country.value === 'Azerbaijan'){
               window.location.href = "Azerbaijan.html";
          } else if (action.value === 'return' && country.value === 'Moroccan'){
               window.location.href = "Morocco.html"
          } else if (action.value === 'return' && country.value === 'Vietnamese'){
               window.location.href = "Vietnam.html"
          } else if (action.value === 'return' && country.value === 'Indian'){
               window.location.href = "India.html"
          } else if (action.value === 'return' && country.value === 'Turkish'){
               window.location.href = "Turkey.html"
          } else {
               window.location.href = "loa.html"
          }
     const actionValue = action.value;
     const countryValue = country.value;
     const fullNameValue = fullName.value;
     const orderNumberValue = orderNumber.value;
     const waybillNumberValue = waybillNumber.value;
     const itemsValue = items.value;
     const currencyValue = currency.value;
     const amountValue = amount.value;
     const dateValue = date.value;
     const customerValue = customer.value;
     const addressValue = address.value;




     localStorage.setItem('action', actionValue);
     localStorage.setItem('country', countryValue);
     localStorage.setItem('full-name', fullNameValue);
     localStorage.setItem('order-number', orderNumberValue);
     localStorage.setItem('waybill-number', waybillNumberValue);
     localStorage.setItem('items', itemsValue);
     localStorage.setItem('currency', currencyValue);
     localStorage.setItem('amount', amountValue);
     localStorage.setItem('date', dateValue);
     localStorage.setItem('customer', customerValue);
     localStorage.setItem('address', addressValue);



})
}

form.addEventListener('reset', function(){
     localStorage.clear();
     window.location.reload();
});

